{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "web",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    }
  ],
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "scripts/**",
      "functions/**",
      "**/_probe/**",
      "**/_probe-community/**",
      "README.txt",
      "firebase/**",
      "**/_probe*/**",
      "**/_probe_shots/**",
      "**/_corrupt_backup/**",
      "**/_corrupt_backup2/**",
      "tests/**"
    ],
    "redirects": [
      { "source": "/guides/mp3-to-midi.html", "destination": "/guides/audio-to-midi.html", "type": 301 },
      { "source": "/workflow/audio-to-midi", "destination": "/guides/audio-to-midi.html", "type": 301 },
      { "source": "/workflow/audio-to-midi.html", "destination": "/guides/audio-to-midi.html", "type": 301 },
      { "source": "/workflow/audio-to-midi/", "destination": "/guides/audio-to-midi.html", "type": 301 },
      { "source": "/workflow/youtube-to-midi", "destination": "/guides/youtube-to-midi.html", "type": 301 },
      { "source": "/workflow/youtube-to-midi.html", "destination": "/guides/youtube-to-midi.html", "type": 301 },
      { "source": "/workflow/youtube-to-midi/", "destination": "/guides/youtube-to-midi.html", "type": 301 },
      { "source": "/workflow/pdf-to-midi", "destination": "/guides/pdf-to-midi.html", "type": 301 },
      { "source": "/workflow/pdf-to-midi.html", "destination": "/guides/pdf-to-midi.html", "type": 301 },
      { "source": "/workflow/pdf-to-midi/", "destination": "/guides/pdf-to-midi.html", "type": 301 },
      { "source": "/workflow/midi-editor", "destination": "/guides/midi-editor.html", "type": 301 },
      { "source": "/workflow/midi-editor.html", "destination": "/guides/midi-editor.html", "type": 301 },
      { "source": "/workflow/midi-editor/", "destination": "/guides/midi-editor.html", "type": 301 }
    ],
    "rewrites": [
      { "source": "/guide/getting-started", "destination": "/guide/getting-started/index.html" },
      { "source": "/guide/getting-started/", "destination": "/guide/getting-started/index.html" },
      { "source": "/guide/youtube-to-midi", "destination": "/guide/youtube-to-midi/index.html" },
      { "source": "/guide/youtube-to-midi/", "destination": "/guide/youtube-to-midi/index.html" },
      { "source": "/guide/audio-to-midi", "destination": "/guide/audio-to-midi/index.html" },
      { "source": "/guide/audio-to-midi/", "destination": "/guide/audio-to-midi/index.html" },
      { "source": "/guide/pdf-to-midi", "destination": "/guide/pdf-to-midi/index.html" },
      { "source": "/guide/pdf-to-midi/", "destination": "/guide/pdf-to-midi/index.html" },
      { "source": "/guide/midi-editor", "destination": "/guide/midi-editor/index.html" },
      { "source": "/guide/midi-editor/", "destination": "/guide/midi-editor/index.html" },
      { "source": "/guide/score-editor", "destination": "/guide/score-editor/index.html" },
      { "source": "/guide/score-editor/", "destination": "/guide/score-editor/index.html" },
      { "source": "/guide/ai-assistant", "destination": "/guide/ai-assistant/index.html" },
      { "source": "/guide/ai-assistant/", "destination": "/guide/ai-assistant/index.html" },
      { "source": "/guide/library", "destination": "/guide/library/index.html" },
      { "source": "/guide/library/", "destination": "/guide/library/index.html" },
      { "source": "/guide/license", "destination": "/guide/license/index.html" },
      { "source": "/guide/license/", "destination": "/guide/license/index.html" },
      { "source": "/guide/troubleshooting", "destination": "/guide/troubleshooting/index.html" },
      { "source": "/guide/troubleshooting/", "destination": "/guide/troubleshooting/index.html" },
      { "source": "/guide", "destination": "/guide/index.html" },
      { "source": "/guide/", "destination": "/guide/index.html" }
    ],
    "headers": [
      {
        "source": "/assets/js/app.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, max-age=0"
          }
        ]
      },
      {
        "source": "/assets/js/app.p0-hotfix.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, max-age=0"
          }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Content-Type",
            "value": "text/html; charset=utf-8"
          },
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/robots.txt",
        "headers": [
          {
            "key": "Content-Type",
            "value": "text/plain; charset=utf-8"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          }
        ]
      },
      {
        "source": "/sitemap.xml",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/xml; charset=utf-8"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          }
        ]
      },
      {
        "source": "/manifest.webmanifest",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/manifest+json; charset=utf-8"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=86400"
          }
        ]
      },
      {
        "source": "**/*.@(jpg|jpeg|gif|png|svg|webp|ico)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=604800"
          }
        ]
      },
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "X-Frame-Options",
            "value": "SAMEORIGIN"
          }
        ]
      }
    ]
  }
}
