rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return signedIn()
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isImage() {
      return request.resource.contentType.matches('image/.*')
        || request.resource.contentType == 'application/octet-stream';
    }

    function isVideo() {
      return request.resource.contentType.matches('video/.*')
        || request.resource.contentType == 'application/octet-stream';
    }

    match /board/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if signedIn()
        && request.auth.uid == userId
        && request.resource.size < 50 * 1024 * 1024
        && request.resource.contentType.matches(
          'image/.*|video/.*|audio/(midi|mid|x-midi|wav|x-wav|wave|mpeg)|application/(x-)?midi'
        );
    }

    match /support/{userId}/{allPaths=**} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if signedIn()
        && request.auth.uid == userId
        && request.resource.size < 50 * 1024 * 1024;
    }

    match /guide-images/{slug}/{fileName} {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.size < 20 * 1024 * 1024
        && isImage();
    }

    match /guide-videos/{slug}/{fileName} {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.size < 80 * 1024 * 1024
        && isVideo();
    }

    match /product-images/{sectionId}/{fileName} {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.size < 20 * 1024 * 1024
        && isImage();
    }

    match /product-videos/{sectionId}/{fileName} {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.size < 80 * 1024 * 1024
        && isVideo();
    }

    // Markdown CMS media (images / videos / attachments)
    match /cms-md/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if signedIn()
        && request.auth.uid == userId
        && request.resource.size < 50 * 1024 * 1024
        && request.resource.contentType.matches(
          'image/.*|video/.*|application/pdf|application/zip|application/x-zip-compressed|application/octet-stream'
        );
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
