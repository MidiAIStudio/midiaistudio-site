# Kakao admin Talk alerts — Secret Manager only (never put real values here):
#   firebase functions:secrets:set KAKAO_REST_API_KEY
#   firebase functions:secrets:set KAKAO_CLIENT_SECRET
# Optional CLI test header for testKakaoAdminNotification:
#   firebase functions:secrets:set KAKAO_ADMIN_TEST_KEY
#
# Support AI private GitHub source (read-only; never commit values):
# Prefer fine-grained PAT scoped to MidiAIStudio/MidiAI-Studio Contents:Read + Metadata:Read:
#   firebase functions:secrets:set GITHUB_SUPPORT_AI_TOKEN
# Or GitHub App installation (all three required):
#   firebase functions:secrets:set GITHUB_APP_ID
#   firebase functions:secrets:set GITHUB_APP_PRIVATE_KEY
#   firebase functions:secrets:set GITHUB_INSTALLATION_ID
# Optional override (default: repo-cleanup-support-ai):
#   SUPPORT_AI_SOURCE_REF=main
#
# Code uses defineSecret + function secrets binding.
#
# PortOne cancel/refund sync (env):
#   PORTONE_API_SECRET
#   PORTONE_STORE_ID
#   PORTONE_WEBHOOK_SECRET   # Standard Webhooks secret from PortOne console
# Public webhook URL after deploy:
#   https://<region>-<project>.cloudfunctions.net/portoneWebhook
