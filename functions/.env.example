# Discord webhooks — do NOT put real URLs here.
# Register secrets with Secret Manager only:
#   firebase functions:secrets:set DISCORD_INQUIRY_WEBHOOK
#   firebase functions:secrets:set DISCORD_PAYMENT_WEBHOOK
# Then deploy the notify functions.
#
# Code uses defineSecret + functions.runWith({ secrets: [...] }).
# Do not use functions/.env for these webhooks.
#
# PortOne cancel/refund sync (env, not Discord secrets):
#   PORTONE_API_SECRET
#   PORTONE_STORE_ID
#   PORTONE_WEBHOOK_SECRET   # Standard Webhooks secret from PortOne console
# Public webhook URL after deploy:
#   https://<region>-<project>.cloudfunctions.net/portoneWebhook

