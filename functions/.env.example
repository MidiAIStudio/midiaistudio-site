# Firebase Functions environment variables
PAYPAL_ENV=live
PAYPAL_CLIENT_ID=YOUR_LIVE_PAYPAL_CLIENT_ID
PAYPAL_CLIENT_SECRET=YOUR_LIVE_PAYPAL_CLIENT_SECRET
PAYPAL_WEBHOOK_ID=YOUR_LIVE_WEBHOOK_ID_AFTER_CREATING_WEBHOOK
PAYPAL_PRICE_VALUE=69.00
PAYPAL_CURRENCY=USD
PAYPAL_PLAN=lifetime
APP_ORIGIN=https://midiaistudio.com

# PortOne V2 (KakaoPay) — server only. NEVER put API Secret in client JS / config.js.
# Issue at: PortOne Console → 결제연동 → 식별코드·API Keys → V2 API Secret
#
# Go-live (paste values yourself — do not commit real secrets):
#   1) Set PORTONE_API_SECRET to the live V2 API Secret
#   2) Set PORTONE_ENVIRONMENT=live
#   3) In assets/js/config.js replace portoneKakaoPayChannelKey with the live channel key
#      and set portoneMode: "live"
#   4) Redeploy Functions (for .env) and Hosting (for config.js)
PORTONE_API_SECRET=YOUR_PORTONE_V2_API_SECRET
PORTONE_STORE_ID=store-034b6f5a-1dd6-4ee9-a83d-4fe7d8dfb6dd
PORTONE_ENVIRONMENT=test
PORTONE_KR_AMOUNT=90000
PORTONE_KR_CURRENCY=KRW
PORTONE_PLAN=lifetime
PORTONE_PRODUCT_ID=midiai-lifetime
PORTONE_ORDER_NAME=MidiAI Studio Lifetime License
