    "order": 50,
    "sections": [
      {
        "i": 0,
        "id": "sec_midi-editor_midi-편집-열기",
        "title": "MIDI 편집 열기",
        "body": "왼쪽 **MIDI 편집**으로 이동합니다. 상단에 **PRO** 배지와 메뉴(파일·편집·보기·삽입·도구·트랜스포트·도움말)가 있습니다. 트랙 목록에서 악기(예: 그랜드 피아노)를 확인하세요.",
        "mediaType": "video",
        "mediaUrl": "https://firebasestorage.googleapis.com/v0/b/midiaistudio.firebasestorage.app/o/guide-videos%2Fmidi-editor%2Fannotated.mp4?alt=media&token=9c246c6f-3f53-4b84-bd75-a7c37f9b7614",
        "posterUrl": "https://firebasestorage.googleapis.com/v0/b/midiaistudio.firebasestorage.app/o/guide-images%2Fmidi-editor%2Fhero.jpg?alt=media&token=25d50dd9-1e2b-4d3e-9923-cd8e87d6a6ba",
        "file": "annotated.mp4"
      },
      {
        "i": 1,
        "id": "sec_midi-editor_피아노-롤에서-노트-편집",
        "title": "피아노 롤에서 노트 편집",
        "body": "중앙 **피아노 롤**에서 음표 피치·길이를 드래그로 조정합니다. 하단 **Performance**에서 **Velocity**, Pitch, Mod, Expr 등을 다듬고, 스냅·BPM·루프를 맞춘 뒤 재생으로 확인합니다.",
        "mediaType": "image",
        "mediaUrl": "https://firebasestorage.googleapis.com/v0/b/midiaistudio.firebasestorage.app/o/guide-images%2Fmidi-editor%2Froll.jpg?alt=media&token=d4c13177-bdaa-4e70-abbe-997d8ad91545",
        "posterUrl": "",
        "file": "roll.jpg"
      },
      {
        "i": 2,
        "id": "sec_midi-editor_악기-변경--내보내기",
        "title": "악기 변경 · 내보내기",
        "body": "트랙 악기를 바꾸고 저장합니다. 악보가 필요하면 PDF/MusicXML로 내보내거나 **악보 편집기**로 이어가세요. 작업 파일은 **라이브러리**에서도 다시 열 수 있습니다.",
        "mediaType": "image",
        "mediaUrl": "https://firebasestorage.googleapis.com/v0/b/midiaistudio.firebasestorage.app/o/guide-images%2Fmidi-editor%2Finstruments.jpg?alt=media&token=411bbfcd-00cf-472d-b92a-0bace32090d8",
        "posterUrl": "",
        "file": "instruments.jpg"
      }
    ]
  },
