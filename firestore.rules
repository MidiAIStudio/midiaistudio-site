rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Must stay aligned with site JS normalizeRole() → admin.
    // Source of truth: users/{request.auth.uid}.role
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') in ['admin', 'developer', 'staff'];
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();

      match /notifications/{notifId} {
        allow read, update, delete: if isOwner(userId) || isAdmin();
        allow create: if request.resource.data.read == false
          && request.resource.data.actorUid == request.auth.uid
          && (
            (
              isAdmin()
              && request.resource.data.type in ['ticket_reply', 'license_change', 'board_comment', 'admin_message']
            )
            || (
              signedIn()
              && request.resource.data.type == 'board_comment'
              && userId != request.auth.uid
              && request.resource.data.postId is string
              && (
                get(/databases/$(database)/documents/boardPosts/$(request.resource.data.postId)).data.get('uid', '') == userId
                || get(/databases/$(database)/documents/boardPosts/$(request.resource.data.postId)).data.get('authorUid', '') == userId
              )
            )
          );
      }

      // FULL feature usage evidence — admin CRM read only (writes via Admin SDK / Functions).
      match /usage/{docId} {
        allow read: if isAdmin();
        allow write: if false;
      }
      match /usageProofs/{eventId} {
        allow read: if isAdmin();
        allow write: if false;
      }
    }

    match /licenses/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      // Trial provisioning is Cloud Functions only (Admin SDK).
      // Clients (including owners) must never create/update/delete licenses.
      allow create, update, delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow write: if isAdmin();
    }

    match /purchaseLocks/{uid} {
      allow read, write: if false;
    }

    match /announcements/{postId} {
      allow read: if resource.data.visible == true || isAdmin();
      allow write: if isAdmin();
    }

    match /patchNotes/{postId} {
      allow read: if resource.data.visible == true || isAdmin();
      allow write: if isAdmin();
    }

    match /faq/{faqId} {
      allow read: if resource.data.visible == true || isAdmin();
      allow write: if isAdmin();
    }

    match /downloads/{downloadId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Product usage Guide CMS (Visual CMS on /guide/)
    // Public may read published docs (missing published => treated as published).
    // List queries for guests must include where('published','==',true).
    match /guides/{guideId} {
      allow read: if isAdmin()
        || resource.data.get('published', true) == true;
      allow create, update, delete: if isAdmin();
    }

    // Product page Visual CMS
    match /productSections/{sectionId} {
      allow read: if isAdmin()
        || resource.data.get('published', true) == true;
      allow create, update, delete: if isAdmin();
    }

    // Pricing CMS — public read (display); admin write only
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /pricingConfig/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /supportTickets/{ticketId} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid;

      allow read: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid);

      // Owners may bump unread flags on follow-up replies, but cannot mark admin-read themselves.
      allow update: if isAdmin()
        || (signedIn()
          && resource.data.uid == request.auth.uid
          && (
            !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['adminRead', 'adminNotified', 'adminNotifyKind', 'adminNotifyAt'])
            || (
              request.resource.data.adminRead == false
              && request.resource.data.adminNotified == false
            )
          ));

      allow delete: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid);

      match /replies/{replyId} {
        allow read: if isAdmin()
          || (signedIn()
          && get(/databases/$(database)/documents/supportTickets/$(ticketId)).data.uid == request.auth.uid);

        allow create: if signedIn()
          && (
            isAdmin()
            || get(/databases/$(database)/documents/supportTickets/$(ticketId)).data.uid == request.auth.uid
          );

        allow update, delete: if isAdmin();
      }
    }

    function boardEngagementUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let commentOk = changed.hasOnly(['commentCount', 'updatedAt'])
        && request.resource.data.commentCount is int
        && request.resource.data.commentCount >= 0
        && (
          request.resource.data.commentCount == resource.data.get('commentCount', 0) + 1
          || request.resource.data.commentCount == resource.data.get('commentCount', 0) - 1
        );
      let likeOk = changed.hasOnly(['likeCount', 'updatedAt'])
        && request.resource.data.likeCount is int
        && request.resource.data.likeCount >= 0
        && (
          request.resource.data.likeCount == resource.data.get('likeCount', 0) + 1
          || request.resource.data.likeCount == resource.data.get('likeCount', 0) - 1
        );
      let viewOk = (changed.hasOnly(['viewCount']) || changed.hasOnly(['viewCount', 'updatedAt']))
        && request.resource.data.viewCount is int
        && request.resource.data.viewCount == resource.data.get('viewCount', 0) + 1;
      return commentOk || likeOk || viewOk;
    }

    match /boardPosts/{postId} {
      allow read: if resource.data.visible == true || isAdmin();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid;
      allow update: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid)
        || boardEngagementUpdate();
      allow delete: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid);

      match /comments/{commentId} {
        allow read: if get(/databases/$(database)/documents/boardPosts/$(postId)).data.visible == true || isAdmin();
        allow create: if signedIn()
          && request.resource.data.uid == request.auth.uid;
        allow update: if isAdmin()
          || (signedIn() && resource.data.uid == request.auth.uid);
        allow delete: if isAdmin()
          || (signedIn() && resource.data.uid == request.auth.uid);
      }

      match /likes/{userId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow create: if signedIn() && request.auth.uid == userId;
        allow delete: if isAdmin() || (signedIn() && request.auth.uid == userId);
        allow update: if false;
      }
    }
  }
}
